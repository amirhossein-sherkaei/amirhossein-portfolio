{
  "name": "shorakaei-visual-intelligence",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "VISUAL_ASSETS",
      "id": "642bc4362da94c3b86d5e8ffb45790c4"
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://shorakaei.ir",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
    "MAX_INLINE_IMAGES": "1"
  },
  "routes": [
    {
      "pattern": "img.shorakaei.ir/*",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 */3 * * *"]
  }
}
